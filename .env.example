# ==========================================================
# Variables de entorno de ALPE Gestión
# Copie este archivo como .env (desarrollo local) y complete los valores.
# NUNCA suba el archivo .env a GitHub.
# ==========================================================

# Cadena de conexión PostgreSQL.
# Supabase: Project Settings > Database > Connection string > "Session pooler"
# Ejemplo: postgresql://postgres.abcdefghijkl:SU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alpe

# true si la base de datos exige SSL (Supabase: true). Local: false
DATABASE_SSL=false

# Clave secreta para firmar las sesiones. Use un texto largo y aleatorio (mínimo 32 caracteres).
JWT_SECRET=cambie-esto-por-un-texto-largo-y-aleatorio-de-al-menos-32-caracteres

# Administrador inicial: se crea automáticamente al arrancar SOLO si no existe ningún usuario.
ADMIN_EMAIL=admin@alpe.com.co
ADMIN_PASSWORD=CambieEstaClave2026
ADMIN_NAME=Administrador

# true para cargar datos de demostración al arrancar (solo si la base está vacía).
SEED_DEMO_DATA=false

# Puerto (Render lo asigna automáticamente; localmente 3001)
PORT=3001

# production en Render
NODE_ENV=development

# Zona horaria del negocio (para "hoy", vencimientos, etc.)
APP_TIMEZONE=America/Bogota
